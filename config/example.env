# Required canonical absolute paths. Do not use symlinked paths.
MODEL_DIR=/absolute/path/to/GLM-5.3-Flash-Uncensored-EXL3
DRAFT_DIR=/absolute/path/to/GLM-5.3-Flash-DFlash2
CACHE_DIR=/absolute/path/to/glm53-runtime-cache

# Exactly two physical host GPU indices. Select only RTX PRO 6000 Blackwell 96GB cards.
GPU_DEVICES=0,1

# Loopback is safe for an unauthenticated API. Use a trusted LAN/Tailnet IP deliberately.
BIND_ADDRESS=127.0.0.1
PORT=8000
CONTAINER_NAME=glm53-flash-uncensored-exl3
SERVED_MODEL_NAME=glm-5.3-flash-uncensored-exl3

# Exact qualified profile
MAX_MODEL_LEN=262144
MAX_NUM_BATCHED_TOKENS=1024
MAX_NUM_SEQS=8
DFLASH_SPECULATIVE_TOKENS=3
GPU_MEMORY_UTILIZATION=0.979
MAX_IMAGES_PER_PROMPT=1
NCCL_DEBUG=WARN
